# Server-side only. Configure the key for RoyaleAPI's proxy IP 45.79.218.79.
CLASH_ROYALE_API_KEY=

# Server-side Supabase Data API access.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# PostgreSQL session-pooler URI. Required only for applying SQL migrations.
DATABASE_URL=

# Deployment only. Create in Supabase Dashboard > Account > Access Tokens.
SUPABASE_ACCESS_TOKEN=

# Generated automatically by npm run collector:deploy. Dedicated scheduler authentication.
COLLECTION_CRON_SECRET=
