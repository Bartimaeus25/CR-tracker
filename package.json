    "collector:deploy": "tsx scripts/supabase-collector.ts deploy",
    "collector:activate": "tsx scripts/supabase-collector.ts activate",
    "collector:verify": "tsx scripts/supabase-collector.ts verify",
    "collector:status": "tsx scripts/supabase-collector.ts status"
